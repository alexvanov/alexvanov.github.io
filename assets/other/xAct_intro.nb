Cell[CellGroupData[{

Cell["2nd (differential) Bianchi identity", "Subsubsection",
 CellChangeTimes->{{3.543509995392803*^9, 3.54351000176121*^9}, {
  3.845356844030657*^9, 
  3.8453568489667473`*^9}},ExpressionUUID->"bb804233-b5fe-47be-a644-\
8fd40b7f033e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"CD", "[", 
   RowBox[{"-", "e"}], "]"}], "[", 
  RowBox[{"RiemannCD", "[", 
   RowBox[{
    RowBox[{"-", "a"}], ",", 
    RowBox[{"-", "b"}], ",", 
    RowBox[{"-", "c"}], ",", 
    RowBox[{"-", "d"}]}], "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.54351001328585*^9, 3.543510017810485*^9}},
 CellLabel->"In[45]:=",ExpressionUUID->"5bbc4a94-6df2-41b9-b7b3-1809e6b65f23"],

Cell["\<\
Antisymmetrize in the last 2 indices and the one in the covariant derivative \
: \
\>", "Text",
 CellChangeTimes->{{3.845356877371079*^9, 
  3.845356893222465*^9}},ExpressionUUID->"d3af7f1f-49f8-4584-8e7f-\
7aa3c597bd90"],

Cell[BoxData[
 RowBox[{"Antisymmetrize", "[", 
  RowBox[{"%", ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "c"}], ",", 
     RowBox[{"-", "d"}], ",", 
     RowBox[{"-", "e"}]}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.543510022092802*^9, 3.543510038136792*^9}},
 CellLabel->"In[46]:=",ExpressionUUID->"0f371473-624a-4d95-a623-d9bf8ee0268a"],

Cell[BoxData[
 RowBox[{"%", "//", "ToCanonical"}]], "Input",
