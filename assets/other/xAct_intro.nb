               False]& , 
              Complement[
              xAct`xTensor`Private`allbundles, 
               xAct`xTensor`Private`curvedbundles]]; UpSet[
              xAct`xTensor`MetricOfCovD[xAct`xTensor`Private`covd], 
              xAct`xTensor`Private`metric]; UpSet[
              xAct`xTensor`WeightedWithBasis[xAct`xTensor`Private`covd], 
              xAct`xTensor`Private`wwb]; 
            xAct`xTensor`Private`SymbolRelations[
             xAct`xTensor`Private`covd, xAct`xTensor`Private`master, 
              If[
              xAct`xTensor`Private`ef === Null, {
               xAct`xTensor`Private`manifold}, {
               xAct`xTensor`Private`manifold, xAct`xTensor`Private`ef}]]; 
            UpSet[
              xAct`xTensor`DefInfo[xAct`xTensor`Private`covd], 
              xAct`xTensor`Private`info]; 
            xAct`xTensor`Private`MakeLinearDerivative[
             xAct`xTensor`Private`covd, xAct`xTensor`Private`ot === {}]; 
            xAct`xTensor`Private`MakeTensorialDerivative[
             xAct`xTensor`Private`covd]; If[xAct`xTensor`Private`ot =!= {}, 
              xAct`xTensor`Private`MakeOrthogonalDerivative[
              xAct`xTensor`Private`covd, 
               First[xAct`xTensor`Private`pw], 
               First[xAct`xTensor`Private`ot]]]; 
            If[xAct`xTensor`Private`pw =!= {}, 
              xAct`xTensor`Private`MakeProjectedDerivative[
              xAct`xTensor`Private`covd, 
               First[xAct`xTensor`Private`pw], 
               First[xAct`xTensor`Private`ot]]]; 
            If[xAct`xTensor`Private`info =!= False, xAct`xTensor`Private`info = 
              xAct`xTensor`$DefInfoQ]; 
            If[xAct`xTensor`Private`ef =!= Null, UpSet[
                xAct`xTensor`ExtendedFrom[xAct`xTensor`Private`covd], 
                xAct`xTensor`Private`ef]; 
              xAct`xTensor`Private`defcovdTangent[
               xAct`xTensor`Private`covd, xAct`xTensor`Private`tbundle, {
                 xAct`xTensor`MetricOfCovD[xAct`xTensor`Private`ef], 
                 xAct`xTensor`Private`ef}, {
                xAct`xTensor`Private`ot, xAct`xTensor`Private`pw, 
                 xAct`xTensor`Private`info}], 
              xAct`xTensor`Private`defcovdTangent[
              xAct`xTensor`Private`covd, xAct`xTensor`Private`tbundle, {
               xAct`xTensor`Private`torsion, 
                xAct`xTensor`CurvatureQ[
                xAct`xTensor`Private`covd, xAct`xTensor`Private`tbundle], 
                xAct`xTensor`Private`metric, xAct`xTensor`Private`curvrels}, {
               xAct`xTensor`Private`ot, xAct`xTensor`Private`pw, 
                xAct`xTensor`Private`info}]]; 
            If[Length[xAct`xTensor`Private`allbundles] > 1, 
              xAct`xTensor`Private`defcovdFiber[
              xAct`xTensor`Private`covd, xAct`xTensor`Private`tbundle, 
               Part[xAct`xTensor`Private`allbundles, 2], 
               MemberQ[xAct`xTensor`Private`curvedbundles, 
                Part[xAct`xTensor`Private`allbundles, 2]], 
               xAct`xTensor`Private`info]]; 
            xAct`xCore`MakexTensions[xAct`xTensor`DefCovD, "End", 
              xAct`xTensor`Private`covd[xAct`xTensor`Private`ind], 
              xAct`xTensor`Private`vbundles, xAct`xTensor`Private`options]; 
            If[xAct`xTensor`Private`pns, 
              Protect[xAct`xTensor`Private`covd]]; Null]]]}], "SubValues" -> 
    None, "DefaultValues" -> None, "NValues" -> None, "FormatValues" -> None, 
