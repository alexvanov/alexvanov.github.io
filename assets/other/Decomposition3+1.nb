Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"m4tric", "[", 
    RowBox[{"c", ",", "d"}], "]"}], 
   RowBox[{"Riemanncd4", "[", 
    RowBox[{
     RowBox[{"-", "a"}], ",", 
     RowBox[{"-", "c"}], ",", 
     RowBox[{"-", "b"}], ",", 
     RowBox[{"-", "d"}]}], "]"}]}], "-", 
  RowBox[{"8", "\[Pi]", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"T", "[", 
      RowBox[{
       RowBox[{"-", "a"}], ",", 
       RowBox[{"-", "b"}]}], "]"}], "-", 
     RowBox[{
      RowBox[{"1", "/", "2"}], 
      RowBox[{"m4tric", "[", 
       RowBox[{
        RowBox[{"-", "a"}], ",", 
        RowBox[{"-", "b"}]}], "]"}], 
      RowBox[{"T", "[", 
       RowBox[{
        RowBox[{"-", "c"}], ",", "c"}], "]"}]}]}], 
    ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"%", "//", "MetricToProjector"}], "//", 
  "ToCanonical"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ProjectWith", "[", "m3tric", "]"}], "[", "%", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"%", "/.", "ContractedGaussrule"}], "/.", "Riccirule"}], "/.", 
      "rhorule"}], "/.", "trSrule"}], "/.", "Srule"}], "/.", "Lienrule"}], "//",
   "ToCanonical"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{"%", "==", "0"}], ",", 
    RowBox[{
     RowBox[{"LieD", "[", "t", "]"}], "[", 
     RowBox[{"ExtrinsicKm3tric", "[", 
      RowBox[{
       RowBox[{"-", "a"}], ",", 
       RowBox[{"-", "b"}]}], "]"}], "]"}]}], "]"}], "[", 
  RowBox[{"[", 
   RowBox[{"1", ",", "1"}], "]"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Keq", "[", 
   RowBox[{
    RowBox[{"-", "a_"}], ",", 
    RowBox[{"-", "b_"}]}], "]"}], "=", 
  RowBox[{
   RowBox[{"Collect", "[", 
    RowBox[{"%", ",", 
     RowBox[{"\[Alpha]", "[", "]"}]}], "]"}], "//", "ScreenDollarIndices", 
   RowBox[{"(*", 
    RowBox[{
    "to", " ", "make", " ", "the", " ", "indices", " ", "look", " ", 
     "nicer"}], "*)"}]}]}]}], "Input",
 CellChangeTimes->{
