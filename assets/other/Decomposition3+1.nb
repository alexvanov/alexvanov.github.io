Cell["\<\
Twice the Einstein equations contracted twice with the normal vector -> \
Hamiltonian equation: \
\>", "Text",
 CellChangeTimes->{{3.847297283312688*^9, 
  3.8472973195547*^9}},ExpressionUUID->"97a5bc86-d9ef-4f5e-bbe4-0982e4f928d9"],

