  RowBox[{
   RowBox[{"%", "/.", "ScalarGaussrule"}], "/.", "rhorule"}], "//", 
  "ToCanonical"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Heq", "[", "]"}], "=", 
  RowBox[{
   RowBox[{
    RowBox[{"H", "[", "]"}], "->", "%"}], "//", "ScreenDollarIndices", 
   RowBox[{"(*", 
    RowBox[{
    "to", " ", "make", " ", "the", " ", "indices", " ", "look", " ", 
     "nicer"}], "*)"}]}]}]}], "Input",
