466125790223"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"DefMetric", "[", 
   RowBox[{"1", ",", 
    RowBox[{"m3tric", "[", 
     RowBox[{
      RowBox[{"-", "a"}], ",", 
      RowBox[{"-", "b"}]}], "]"}], ",", "cd3", ",", 
    RowBox[{"SymbolOfCovD", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"\"\<:\>\"", ",", "\"\<D\>\""}], "}"}]}], ",", 
    RowBox[{"InducedFrom", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"m4tric", ",", "n"}], "}"}]}], ",", 
    RowBox[{"PrintAs", "\[Rule]", "\"\<\[Gamma]\>\""}]}], "]"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "definition", " ", "of", " ", "spatial", " ", "metric", " ", "m3tric", 
     " ", "denoted", " ", "as", " ", "\[Gamma]"}], ",", " ", 
    RowBox[{"signature", " ", 
     RowBox[{"(", 
      RowBox[{"+", 
       RowBox[{",", 
        RowBox[{"+", 
         RowBox[{",", "+"}]}]}]}], ")"}], " ", "and", " ", "associated", " ", 
     "covariant", " ", "derivative", " ", "cd3"}]}], "*)"}]}]], "Input",
