Cell[CellGroupData[{

Cell["Momentum constraint", "Subsubsection",
 CellChangeTimes->{{3.8472877950379963`*^9, 
  3.847287797653161*^9}},ExpressionUUID->"3ace8570-d677-4941-a19d-\
431980b8255b"],

Cell["\<\
Project the Riemann to obtain the Codazzi-Mainardi equation and then contract \
once with the spatial metric to obtain the contracted Codazzi equation. \
Express it as a rule to substitute below : \
\>", "Text",
 CellChangeTimes->{{3.8472973408280354`*^9, 
  3.847297381382852*^9}},ExpressionUUID->"0003b478-0987-4b83-8def-\
903cfa2f5430"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ProjectWith", "[", "m3tric", "]"}], "[", 
   RowBox[{
    RowBox[{"n", "[", "d", "]"}], 
    RowBox[{"Riemanncd4", "[", 
     RowBox[{
      RowBox[{"-", "a"}], ",", 
      RowBox[{"-", "b"}], ",", 
      RowBox[{"-", "c"}], ",", 
      RowBox[{"-", "d"}]}], "]"}]}], "]"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"LHS", " ", "of", " ", "Codazzi"}], "-", 
    RowBox[{"Mainardi", " ", "equation"}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"GaussCodazzi", "[", 
  RowBox[{"%", ",", "m3tric"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"%", "//", "ToCanonical"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"RHS", " ", "of", " ", "Codazzi"}], "-", 
    RowBox[{"Mainardi", " ", "equation"}]}], "*)"}]}], "\[IndentingNewLine]", 

 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"m3tric", "[", 
     RowBox[{"a", ",", "c"}], "]"}], "%"}], "//", "ContractMetric"}], 
  RowBox[{"(*", 
   RowBox[{
   "RHS", " ", "of", " ", "contracted", " ", "Codazzi", " ", "equation"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"m3tric", "[", 
     RowBox[{"a", ",", "c"}], "]"}], "%%%%"}], "/.", 
   RowBox[{"MakeRule", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"m3tric", "[", 
       RowBox[{
        RowBox[{"-", "b"}], ",", "c"}], "]"}], ",", 
      RowBox[{"T", "[", 
       RowBox[{
        RowBox[{"-", "b"}], ",", "c"}], "]"}]}], "}"}], "]"}]}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "dirty", " ", "trick", " ", "to", " ", "avoid", " ", "substituting", " ", 
     "the", " ", "projector", " ", "by", " ", "the", " ", "4"}], "-", 
    "metric"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"%", "//", "ProjectorToMetric"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"%", "/.", 
   RowBox[{"MakeRule", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"T", "[", 
       RowBox[{
        RowBox[{"-", "b"}], ",", "c"}], "]"}], ",", 
      RowBox[{"m3tric", "[", 
       RowBox[{
        RowBox[{"-", "b"}], ",", "c"}], "]"}]}], "}"}], "]"}]}], 
  RowBox[{"(*", 
   RowBox[{"undo", " ", "dirty", " ", "trick"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"%", "//", "ToCanonical"}], "//", "ContractMetric"}], 
  RowBox[{"(*", 
   RowBox[{
   "LHS", " ", "of", " ", "contracted", " ", "Codazzi", " ", "equation"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"ContractedCodazzirule", "=", 
  RowBox[{"MakeRule", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"%", ",", "%%%%%"}], "}"}], "//", "Evaluate"}], 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.847289876694257*^9, 3.8472899538215446`*^9}, {
  3.847290014560609*^9, 3.847290022756812*^9}, {3.8472900713706427`*^9, 
  3.8472900802006807`*^9}, {3.8472901293558397`*^9, 3.8472903932437077`*^9}, {
  3.8472953119239473`*^9, 3.847295314349448*^9}},
 CellLabel->"In[74]:=",ExpressionUUID->"702cf292-8a52-4018-8998-d2d0ac20355b"],

