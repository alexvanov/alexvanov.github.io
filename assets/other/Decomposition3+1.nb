Cell["\<\
Project the Riemann tensor to obtain the Ricci equation and save it as a rule \
to substitute below: \
\>", "Text",
 CellChangeTimes->{{3.847297602097993*^9, 3.84729760323766*^9}, {
  3.847297635741495*^9, 
  3.847297661108755*^9}},ExpressionUUID->"c308b7c5-dea2-4a9c-bf17-\
0d076f1c9159"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ProjectWith", "[", "m3tric", "]"}], "[", 
   RowBox[{
    RowBox[{"n", "[", "c", "]"}], 
    RowBox[{"n", "[", "d", "]"}], 
    RowBox[{"Riemanncd4", "[", 
     RowBox[{
      RowBox[{"-", "a"}], ",", 
      RowBox[{"-", "c"}], ",", 
      RowBox[{"-", "b"}], ",", 
      RowBox[{"-", "d"}]}], "]"}]}], "]"}], 
  RowBox[{"(*", 
   RowBox[{"LHS", " ", "of", " ", "Ricci", " ", "equation"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"GaussCodazzi", "[", 
   RowBox[{"%", ",", "m3tric"}], "]"}], "/.", 
  "projrule"}], "\[IndentingNewLine]", 
 RowBox[{"%", "//", "ToCanonical"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ToInducedDerivative", "[", 
    RowBox[{"%", ",", "cd4", ",", "cd3"}], "]"}], "//", "ProjectorToMetric"}],
   "//", "ContractMetric"}], "\[IndentingNewLine]", 
 RowBox[{"%", "//", "GradNormalToExtrinsicK"}], "\[IndentingNewLine]", 
 RowBox[{"%", "//", "ToCanonical"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"%", "/.", "acrule"}], 
  RowBox[{"(*", 
   RowBox[{"RHS", " ", "of", " ", "Ricci", " ", "equation"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"Riccirule", "=", 
  RowBox[{"MakeRule", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"%%%%%%%", ",", "%"}], "}"}], "//", "Evaluate"}], 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.847294462471088*^9, 3.847294518717716*^9}, {
