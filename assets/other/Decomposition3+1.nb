Cell[BoxData[{
 RowBox[{"2", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"Einsteincd4", "[", 
     RowBox[{
      RowBox[{"-", "a"}], ",", 
      RowBox[{"-", "b"}]}], "]"}], "-", 
    RowBox[{"8", "\[Pi]", " ", 
     RowBox[{"T", "[", 
      RowBox[{
       RowBox[{"-", "a"}], ",", 
       RowBox[{"-", "b"}]}], "]"}]}]}], ")"}]}], "\[IndentingNewLine]", 
 RowBox[{"%", "//", "EinsteinToRicci"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"n", "[", "a", "]"}], 
   RowBox[{"n", "[", "b", "]"}], "%"}], "//", 
  "ContractMetric"}], "\[IndentingNewLine]", 
