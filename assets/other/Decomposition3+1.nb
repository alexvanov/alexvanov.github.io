Cell["\<\
We choose the sign convention for the acceleration that is normally used in \
Numerical relativity: \
\>", "Text",
 CellChangeTimes->{{3.847296833523971*^9, 
  3.847296864348187*^9}},ExpressionUUID->"7fed3400-f16f-4e7e-983a-\
