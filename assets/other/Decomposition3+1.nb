Cell[CellGroupData[{

Cell["Definition of manifold and 4-metric", "Subsection",
 CellChangeTimes->{
  3.509192970613252*^9, {3.5726925180383797`*^9, 3.572692518752901*^9}, {
   3.619877498525853*^9, 3.619877508695632*^9}, {3.7009929480699787`*^9, 
   3.700992980527782*^9}, {3.7053855650320377`*^9, 3.705385568392068*^9}, 
   3.705385687790909*^9},ExpressionUUID->"9bc981e0-b842-4090-80fa-\
0e06ae1560f7"],

Cell["\<\
Here, we define the 4-dimensional spacetime {M, gg_{ab} } with manifold $M$ \
and metric $gg_{ab} $. 
The signature is (-,+,+,...,+) The covariant derivative with respect to \
$gg_{ab}$ is denoted as \[OpenCurlyDoubleQuote]CD\[CloseCurlyDoubleQuote] and \
(by default) printed as $\\nabla$.
We also specify a list of characters used as indices throughout our \
computations.\
\>", "Text",
 CellChangeTimes->{{3.57148749362014*^9, 3.571487667499951*^9}, {
   3.5782162292080584`*^9, 3.578216258655488*^9}, {3.6028368192697477`*^9, 
   3.602836860329069*^9}, {3.602837162729537*^9, 3.602837206934362*^9}, {
   3.602838016821274*^9, 3.602838083425168*^9}, {3.6028387059068193`*^9, 
   3.602838724775486*^9}, 3.602846321280808*^9, {3.619877439272087*^9, 
   3.6198774580010567`*^9}, {3.705385621724765*^9, 
   3.7053856363737183`*^9}},ExpressionUUID->"819fc5c3-490a-4486-97df-\
d5c1bcff85bf"],

