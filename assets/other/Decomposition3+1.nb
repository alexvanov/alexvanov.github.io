Cell["\<\
Write rules to substitute the projections by their corresponding quantities: \
\
\>", "Text",
 CellChangeTimes->{{3.847286892296835*^9, 
  3.847286922745124*^9}},ExpressionUUID->"32ccfde3-6c55-449a-b911-\
c29c406d64bd"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"rhorule", "=", 
  RowBox[{"MakeRule", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"n", "[", "a", "]"}], 
      RowBox[{"n", "[", "b", "]"}], 
      RowBox[{"T", "[", 
       RowBox[{
        RowBox[{"-", "a"}], ",", 
        RowBox[{"-", "b"}]}], "]"}]}], ",", 
     RowBox[{"\[Rho]", "[", "]"}]}], "}"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Jrule", "=", 
  RowBox[{"MakeRule", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"m3tric", "[", 
        RowBox[{
         RowBox[{"-", "a"}], ",", "c"}], "]"}], 
       RowBox[{"n", "[", "b", "]"}], 
       RowBox[{"T", "[", 
        RowBox[{
         RowBox[{"-", "b"}], ",", 
         RowBox[{"-", "c"}]}], "]"}]}], ",", 
      RowBox[{"-", 
       RowBox[{"J", "[", 
        RowBox[{"-", "a"}], "]"}]}]}], "}"}], ",", 
    RowBox[{"MetricOn", "->", 
     RowBox[{"{", "c", "}"}]}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Srule", "=", 
  RowBox[{"MakeRule", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"m3tric", "[", 
       RowBox[{
        RowBox[{"-", "a"}], ",", "c"}], "]"}], 
      RowBox[{"m3tric", "[", 
       RowBox[{
        RowBox[{"-", "b"}], ",", "d"}], "]"}], 
      RowBox[{"T", "[", 
       RowBox[{
        RowBox[{"-", "c"}], ",", 
        RowBox[{"-", "d"}]}], "]"}]}], ",", 
     RowBox[{"S", "[", 
      RowBox[{
       RowBox[{"-", "a"}], ",", 
       RowBox[{"-", "b"}]}], "]"}]}], "}"}], 
   RowBox[{"(*", 
    RowBox[{",", 
     RowBox[{"MetricOn", "->", 
      RowBox[{"{", 
       RowBox[{"c", ",", "d"}], "}"}]}]}], "*)"}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.847286929687999*^9, 3.847286958320751*^9}, {
   3.8472870284207077`*^9, 3.8472871648819237`*^9}, {3.8472872790496683`*^9, 
