Cell[CellGroupData[{

Cell["Decomposition of the energy-momentum tensor", "Subsection",
 CellChangeTimes->{{3.8472865207451878`*^9, 
  3.847286531356854*^9}},ExpressionUUID->"46d1f941-88d3-40f9-a30b-\
413c393bde74"],

Cell["\<\
Decompose the energy-momentum tensor and define its various projections
(a) energy density:             \[Rho] = T_{ab} n^{a} n^{b}
(b) energy current:            J_i = -T_{ab} n^a \[Gamma]^{b}_{i}
(c) spatial components:  S_{ij} = \[Gamma]^a_i \[Gamma]^b_j T_{ab}\
\>", "Text",
 CellChangeTimes->{{3.8472868466020947`*^9, 3.847286878317151*^9}, 
   3.847298572715815*^9},ExpressionUUID->"2fa3cdeb-7be2-4de5-91fe-\
e317a2ce3ab8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DefTensor", "[", 
  RowBox[{
   RowBox[{"T", "[", 
    RowBox[{
     RowBox[{"-", "a"}], ",", 
     RowBox[{"-", "b"}]}], "]"}], ",", "M4", ",", 
   RowBox[{"Symmetric", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "a"}], ",", 
      RowBox[{"-", "b"}]}], "}"}], "]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.8472866299904423`*^9, 3.847286635837844*^9}},
 CellLabel->"In[23]:=",ExpressionUUID->"d880b356-5009-4055-86f4-405973e4e493"],

