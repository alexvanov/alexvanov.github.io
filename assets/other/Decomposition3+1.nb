  3.535361777898272*^9, 3.535361781097698*^9}, {3.535867752925951*^9, 
  3.535867756733967*^9}, {3.5358678168700447`*^9, 3.5358678198222933`*^9}, {
  3.5358681428863697`*^9, 3.5358681713584623`*^9}, {3.5359631678285103`*^9, 
  3.5359631720702047`*^9}, {3.535963268399577*^9, 3.535963288999837*^9}},
 CellLabel->"In[16]:=",ExpressionUUID->"6ee92a20-b603-4190-9bfc-966601b33638"],

Cell["\<\
Define a rule to substitute the acceleration of Eulerian observers in terms \
of the lapse:\
\>", "Text",
 CellChangeTimes->{{3.8472968744754543`*^9, 
  3.8472969057639017`*^9}},ExpressionUUID->"22f94452-1988-4a0c-a413-\
21fd5858c4af"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"acrule", "=", 
  RowBox[{"MakeRule", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Accelerationn", "[", 
       RowBox[{"-", "b"}], "]"}], ",", 
      RowBox[{"Evaluate", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"cd3", "[", 
          RowBox[{"-", "b"}], "]"}], "[", 
         RowBox[{"Log", "[", 
          RowBox[{"\[Alpha]", "[", "]"}], "]"}], "]"}], "//", "ToCanonical"}],
        "]"}]}], "}"}], ",", 
    RowBox[{"MetricOn", "\[Rule]", "All"}], ",", 
    RowBox[{"ContractMetrics", "\[Rule]", "True"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.53543559201659*^9, 3.535435624853571*^9}, {
   3.53544085023212*^9, 3.535440853200791*^9}, 3.535868424123048*^9, {
   3.535868514155212*^9, 3.535868524414201*^9}, {3.5359602869811296`*^9, 
   3.535960325052644*^9}, {3.5359612690138607`*^9, 3.535961269221198*^9}, {
   3.535961301173655*^9, 3.535961301612884*^9}, 3.535961416726158*^9, 
   3.5359633265023327`*^9, {3.536305962497354*^9, 3.536305968352838*^9}, {
   3.536313039076165*^9, 3.536313065723324*^9}, {3.5363933194184*^9, 
