Cell[TextData[{
 "Minus the Einstein equations in a mixed projection -> momentum constraint: ",
 StyleBox["Ooooops! 3 lines got erased \[OpenCurlyDoubleQuote]by mistake\
\[CloseCurlyDoubleQuote] ... Exercise: complete the derivation of the \
momentum constraint! (Hint: this part is equivalent to that of the \
Hamiltonian constraint). ",
  FontColor->RGBColor[1, 0, 0]]
}], "Text",
 CellChangeTimes->{{3.8472974070835657`*^9, 3.847297431914853*^9}, {
  3.84729830690172*^9, 3.8472983686462593`*^9}, {3.847298486061145*^9, 
  3.84729852186465*^9}},ExpressionUUID->"ac61650b-58b1-401c-8f32-\
0d4f76893d22"],

