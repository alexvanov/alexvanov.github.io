Cell[CellGroupData[{

Cell["Hamiltonian constraint", "Subsubsection",
 CellChangeTimes->{{3.847287786714815*^9, 
  3.847287789653832*^9}},ExpressionUUID->"993704cc-3eb9-490b-a1e4-\
5578eb89a2e1"],

Cell["\<\
Project the Riemann to obtain the Gauss equation and then contract twice with \
the spatial metric to obtain the scalar Gauss equation. Isolate the Ricci \
scalar from the latter to use it a rule to substitute below: \
\>", "Text",
 CellChangeTimes->{{3.847297188185258*^9, 
  3.847297277896359*^9}},ExpressionUUID->"693a92e5-7c04-4c64-ba13-\
2b2b08c6fb5c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ProjectWith", "[", "m3tric", "]"}], "[", 
   RowBox[{"Riemanncd4", "[", 
    RowBox[{
     RowBox[{"-", "a"}], ",", 
     RowBox[{"-", "b"}], ",", 
     RowBox[{"-", "c"}], ",", 
     RowBox[{"-", "d"}]}], "]"}], "]"}], 
  RowBox[{"(*", 
   RowBox[{"LHS", " ", "of", " ", "Gauss", " ", "equation"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"GaussCodazzi", "[", 
  RowBox[{"%", ",", "m3tric"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"%", "//", "ToCanonical"}], 
  RowBox[{"(*", 
   RowBox[{"RHS", " ", "of", " ", "Gauss", " ", "equation"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"m3tric", "[", 
     RowBox[{"a", ",", "c"}], "]"}], 
    RowBox[{"m3tric", "[", 
     RowBox[{"b", ",", "d"}], "]"}], "%"}], "//", "ToCanonical"}], 
  RowBox[{"(*", 
   RowBox[{"RHS", " ", "of", " ", "scalar", " ", "Gauss", " ", "equation"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"m3tric", "[", 
    RowBox[{"a", ",", "c"}], "]"}], 
   RowBox[{"m3tric", "[", 
    RowBox[{"b", ",", "d"}], "]"}], "%%%%"}], "//", 
  "ProjectorToMetric"}], "\[IndentingNewLine]", 
 RowBox[{"%", "//", "ToCanonical"}], "\[IndentingNewLine]", 
 RowBox[{
