Cell["\<\
The projection operator is $\[Gamma]_ {a}^{b} = \[Delta]_ {a}^{b} + n_ {a} \
n^{b} $ . It\[CloseCurlyQuote]s useful to define a rule which allows us to \
replace the projector symbol with the actual projection operator.\
\>", "Text",
 CellChangeTimes->{{3.847286002088767*^9, 
  3.8472860330071077`*^9}},ExpressionUUID->"231a1776-ca68-4d4a-83c1-\
57bea911d2c5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"projrule", "=", 
   RowBox[{"Projectorm3tric", "\[Rule]", 
    RowBox[{"ProjectWith", "[", "m3tric", "]"}]}]}], ";"}]], "Input",
 CellLabel->"In[8]:=",ExpressionUUID->"8f6b9466-d182-4b12-9525-42d783123ffa"],

Cell["\<\
