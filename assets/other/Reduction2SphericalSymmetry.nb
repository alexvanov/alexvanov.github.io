Cell["\<\
CTensor is actually very powerful when dealing with coordinate \
transformations between different bases, as it takes into account the \
Jacobians automatically. Ask me (Alex) for examples or more details if you\
\[CloseCurlyQuote]re interested to know more. \
\>", "Text",
 CellChangeTimes->{{3.8460039839222937`*^9, 
  3.846004051207518*^9}},ExpressionUUID->"2eb18c49-6b6e-4b51-ad01-\
604d81ea59be"]
}, Closed]]
}, Open  ]]
}, Open  ]],

