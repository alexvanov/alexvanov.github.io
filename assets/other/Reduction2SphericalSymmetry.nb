Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", "ij"], "=", 
    RowBox[{"(", GridBox[{
       {
        RowBox[{"a", "[", "r", "]"}], "0", "0"},
       {"0", 
        RowBox[{"b", "[", "r", "]"}], "0"},
       {"0", "0", 
        RowBox[{
         RowBox[{"b", "[", "r", "]"}], 
         SuperscriptBox[
