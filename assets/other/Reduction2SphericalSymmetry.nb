Cell["\<\
Add the Lie derivative term to the rest of the Right Hand Side (RHS) and put \
it together with the LHS:  \
\>", "Text",
 CellChangeTimes->{{3.845996070801634*^9, 3.8459960953923273`*^9}, {
  3.845996420703673*^9, 
  3.845996428172101*^9}},ExpressionUUID->"b68a82aa-7a83-41c8-8ff9-\
1a3d80499a23"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"lhs", "[", 
      RowBox[{"[", 
       RowBox[{"i", ",", "j"}], "]"}], "]"}], "->", 
     RowBox[{
      RowBox[{"liedterm", "[", 
       RowBox[{"[", 
        RowBox[{"i", ",", "j"}], "]"}], "]"}], "-", 
      RowBox[{"2", 
       RowBox[{"\[Alpha]", "[", "r", "]"}], 
       RowBox[{"Kmat", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "j"}], "]"}], "]"}]}]}]}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", "3"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"j", ",", "1", ",", "3"}], "}"}]}], "]"}], "//", 
  "Flatten"}], "\[IndentingNewLine]", 
 RowBox[{"DeleteCases", "[", 
  RowBox[{"%", ",", 
   RowBox[{
    RowBox[{"OverBar", "[", "0", "]"}], "->", "0"}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"First", "@", 
         RowBox[{"%", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], "==", 
        RowBox[{"Last", "@", 
         RowBox[{"%", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}]}], ",", 
       RowBox[{"OverBar", "[", 
        RowBox[{"a", "[", "r", "]"}], "]"}]}], "]"}], ",", 
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"First", "@", 
         RowBox[{"%", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], "==", 
        RowBox[{"Last", "@", 
         RowBox[{"%", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}]}], ",", 
       RowBox[{"OverBar", "[", 
        RowBox[{"b", "[", "r", "]"}], "]"}]}], "]"}], ",", 
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"First", "@", 
         RowBox[{"%", "[", 
          RowBox[{"[", "3", "]"}], "]"}]}], "==", 
        RowBox[{"Last", "@", 
         RowBox[{"%", "[", 
          RowBox[{"[", "3", "]"}], "]"}]}]}], ",", 
       RowBox[{"OverBar", "[", 
        RowBox[{"b", "[", "r", "]"}], "]"}]}], "]"}]}], "}"}], "//", 
   "Flatten"}], "//", "DeleteDuplicates"}]}], "Input",
 CellChangeTimes->{{3.845996113860121*^9, 3.8459961366975613`*^9}, {
  3.845996223405594*^9, 3.845996223681357*^9}, {3.845996432972405*^9, 
  3.845996504511778*^9}},
 CellLabel->
  "In[236]:=",ExpressionUUID->"c722cebd-7229-49fb-bedd-f88651c483a4"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    OverscriptBox[
     RowBox[{
      InterpretationBox[
       StyleBox["a",
        ShowAutoStyles->False,
        AutoSpacing->False],
       $CellContext`a,
