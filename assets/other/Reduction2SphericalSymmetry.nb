Cell[BoxData[{
 RowBox[{
  RowBox[{"eqscheck", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"OverBar", "[", 
       RowBox[{"a", "[", 
        RowBox[{"r", "[", "]"}], "]"}], "]"}], "->", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Beta]r", "[", 
         RowBox[{"r", "[", "]"}], "]"}], 
        RowBox[{
         RowBox[{"a", "'"}], "[", 
         RowBox[{"r", "[", "]"}], "]"}]}], "+", 
       RowBox[{"2", 
        RowBox[{"a", "[", 
         RowBox[{"r", "[", "]"}], "]"}], 
        RowBox[{
         RowBox[{"\[Beta]r", "'"}], "[", 
         RowBox[{"r", "[", "]"}], "]"}]}], "-", 
       RowBox[{"2", 
        RowBox[{"\[Alpha]", "[", 
         RowBox[{"r", "[", "]"}], "]"}], 
        RowBox[{"c", "[", 
         RowBox[{"r", "[", "]"}], "]"}]}]}]}], ",", 
     RowBox[{
      RowBox[{"OverBar", "[", 
       RowBox[{"b", "[", 
        RowBox[{"r", "[", "]"}], "]"}], "]"}], "->", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Beta]r", "[", 
         RowBox[{"r", "[", "]"}], "]"}], 
        RowBox[{
         RowBox[{"b", "'"}], "[", 
         RowBox[{"r", "[", "]"}], "]"}]}], "-", 
       RowBox[{"2", 
        RowBox[{"\[Alpha]", "[", 
         RowBox[{"r", "[", "]"}], "]"}], 
        RowBox[{"d", "[", 
         RowBox[{"r", "[", "]"}], "]"}]}]}]}], ",", 
     RowBox[{
      RowBox[{"OverBar", "[", 
       RowBox[{"c", "[", 
        RowBox[{"r", "[", "]"}], "]"}], "]"}], "->", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         RowBox[{"\[Alpha]", "[", 
          RowBox[{"r", "[", "]"}], "]"}]}], 
        RowBox[{
         SuperscriptBox[
          RowBox[{"c", "[", 
           RowBox[{"r", "[", "]"}], "]"}], "2"], "/", 
         RowBox[{"a", "[", 
          RowBox[{"r", "[", "]"}], "]"}]}]}], "+", 
       RowBox[{"2", 
        RowBox[{"\[Alpha]", "[", 
         RowBox[{"r", "[", "]"}], "]"}], 
        RowBox[{"d", "[", 
         RowBox[{"r", "[", "]"}], "]"}], 
        RowBox[{
         RowBox[{"c", "[", 
          RowBox[{"r", "[", "]"}], "]"}], "/", 
         RowBox[{"b", "[", 
          RowBox[{"r", "[", "]"}], "]"}]}]}], "+", 
       RowBox[{"2", 
        RowBox[{
         RowBox[{"\[Beta]r", "'"}], "[", 
         RowBox[{"r", "[", "]"}], "]"}], 
        RowBox[{"c", "[", 
         RowBox[{"r", "[", "]"}], "]"}]}], "+", 
       RowBox[{
        RowBox[{"\[Alpha]", "[", 
         RowBox[{"r", "[", "]"}], "]"}], 
        RowBox[{
         RowBox[{
          SuperscriptBox[
           RowBox[{
