      }], ")"}]}], TraditionalForm]],ExpressionUUID->
  "95d0502a-b8f7-44c8-b7fb-730742811350"],
 " ,        ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["K", "ij"], "=", 
    RowBox[{"(", GridBox[{
       {
        RowBox[{"c", "[", "r", "]"}], "0", "0"},
       {"0", 
        RowBox[{"d", "[", "r", "]"}], "0"},
       {"0", "0", 
        RowBox[{
         RowBox[{"d", "[", "r", "]"}], 
         SuperscriptBox[
          RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}]}
      }], ")"}]}], TraditionalForm]],ExpressionUUID->
  "8c31eb75-ed53-4b8e-a409-e2655ba285ef"],
