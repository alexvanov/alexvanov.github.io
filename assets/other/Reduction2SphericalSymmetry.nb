  FormBox[
   RowBox[{
    SuperscriptBox["\[Beta]", "i"], "=", 
    RowBox[{"(", GridBox[{
       {
        RowBox[{"\[Beta]r", "[", "r", "]"}]},
       {"0"},
       {"0"}
      }], ")"}]}], TraditionalForm]],ExpressionUUID->
  "38cb7138-b5b9-4ad0-98c6-0fc8feffac77"],
 " ,        \[Alpha]t = \[Alpha][r] ,        check that      trK = ",
