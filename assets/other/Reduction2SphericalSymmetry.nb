Cell[BoxData[{
 RowBox[{"meq", "[", 
  RowBox[{
   RowBox[{"-", "i"}], ",", 
   RowBox[{"-", "j"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"First", "@", "%"}], "/.", 
   RowBox[{
    RowBox[{
     RowBox[{"LieD", "[", "t", "]"}], "[", "z_", "]"}], "->", 
    RowBox[{"dt", " ", "z"}]}]}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "This", " ", "is", " ", "just", " ", "a", " ", "quick", " ", "fix", " ", 
    "to", " ", "have", " ", "the", " ", "time", " ", "derivative", " ", "of", 
    " ", "the", " ", "time", " ", "derivative", " ", "of", " ", "the", " ", 
    "metric", " ", "components", " ", 
    RowBox[{"located", ".", " ", "A"}], " ", "few", " ", "lines", " ", 
    "later", " ", "it", " ", "will", " ", "be", " ", "substituted", " ", "by",
     " ", "and", " ", "overbar", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"denoting", " ", "time", " ", "derivative"}], ")"}], "."}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"ComponentArray", "[", 
      RowBox[{"%", "//", 
       RowBox[{"ToBasis", "[", "spher", "]"}]}], "]"}], "//", "ToValues"}], "//",
     "Simplify"}], "//", "Expand"}], 
  RowBox[{"(*", 
   RowBox[{"components", " ", "of", " ", "the", " ", "LHS"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"LieDToCovD", "[", 
  RowBox[{
   RowBox[{"Last", "@", "%%%"}], ",", "CD"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"ComponentArray", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"%", "//", 
         RowBox[{"ToBasis", "[", "spher", "]"}]}], "//", 
        RowBox[{"DummyToBasis", "[", "spher", "]"}]}], "//", 
       "TraceBasisDummy"}], "]"}], "//", "ToValues"}], "//", "Simplify"}], "//",
    "Expand"}], 
  RowBox[{"(*", 
   RowBox[{"components", " ", "of", " ", "the", " ", "RHS"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"%%%", "[", 
       RowBox[{"[", 
        RowBox[{"ct1", ",", "ct2"}], "]"}], "]"}], "->", 
      RowBox[{"%", "[", 
       RowBox[{"[", 
        RowBox[{"ct1", ",", "ct2"}], "]"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"ct1", ",", "1", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"ct2", ",", "1", ",", "3"}], "}"}]}], "]"}], "//", "Flatten"}], 
  
  RowBox[{"(*", 
   RowBox[{"putting", " ", "the", " ", "equations", " ", "together"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"DeleteCases", "[", 
     RowBox[{"%", ",", 
      RowBox[{"0", "->", "0"}]}], "]"}], "/.", 
    RowBox[{
     RowBox[{"dt", " ", 
      RowBox[{"a", "[", 
       RowBox[{"r", "[", "]"}], "]"}]}], "->", 
     RowBox[{"OverBar", "[", 
      RowBox[{"a", "[", 
       RowBox[{"r", "[", "]"}], "]"}], "]"}]}]}], "/.", 
   RowBox[{
    RowBox[{"dt", " ", 
