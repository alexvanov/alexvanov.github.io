Cell["\<\
Create the Left Hand Side (LHS) by signaling the partial derivative of t with \
an overbar:\
\>", "Text",
 CellChangeTimes->{{3.845996375843298*^9, 
  3.8459964052212667`*^9}},ExpressionUUID->"b9df51a8-355c-4786-b0e0-\
c86988ab16d5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"lhs", "=", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"OverBar", "[", 
      RowBox[{"metricmat", "[", 
       RowBox[{"[", 
        RowBox[{"i", ",", "j"}], "]"}], "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "3"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "1", ",", "3"}], "}"}]}], "]"}], "/.", 
   RowBox[{
    RowBox[{"OverBar", "[", 
     RowBox[{"z_", " ", 
      SuperscriptBox[
       RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}], "]"}], "->", 
    RowBox[{
     RowBox[{"OverBar", "[", "z", "]"}], 
     SuperscriptBox[
      RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}]}]}]}]], "Input",
 CellChangeTimes->{{3.8459963058048153`*^9, 3.8459963680519457`*^9}, {
  3.8459964088441963`*^9, 3.845996410444866*^9}},
 CellLabel->
  "In[231]:=",ExpressionUUID->"87d75f48-3d62-492b-a9de-c18be62a41a2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     OverscriptBox[
      RowBox[{
       InterpretationBox[
        StyleBox["a",
         ShowAutoStyles->False,
         AutoSpacing->False],
        $CellContext`a,
        Editable->False], "[", "r", "]"}], "_"], ",", 
     OverscriptBox["0", "_"], ",", 
     OverscriptBox["0", "_"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     OverscriptBox["0", "_"], ",", 
     OverscriptBox[
      RowBox[{
       InterpretationBox[
        StyleBox["b",
         ShowAutoStyles->False,
         AutoSpacing->False],
        $CellContext`b,
        Editable->False], "[", "r", "]"}], "_"], ",", 
     OverscriptBox["0", "_"]}], "}"}], ",", 
   RowBox[{"{", 
