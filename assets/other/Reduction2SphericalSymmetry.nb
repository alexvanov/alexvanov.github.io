Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"LieD", "[", 
    RowBox[{"\[Beta]c", "[", "h", "]"}], "]"}], "[", 
   RowBox[{"metricc", "[", 
    RowBox[{
     RowBox[{"-", "e"}], ",", 
     RowBox[{"-", "f"}]}], "]"}], "]"}], "-", 
  RowBox[{"2", 
   RowBox[{"Kc", "[", 
    RowBox[{
     RowBox[{"-", "e"}], ",", 
     RowBox[{"-", "f"}]}], "]"}], 
   RowBox[{"\[Alpha]c", "[", "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"ComponentArray", "[", 
  RowBox[{"%", "//", 
   RowBox[{"ToBasis", "[", "spherc", "]"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"DeleteCases", "[", 
  RowBox[{
   RowBox[{"%", "//", "Flatten"}], ",", "0"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"aeqspherc", "=", 
  RowBox[{
   RowBox[{"OverBar", "[", 
    RowBox[{"a", "[", 
     RowBox[{"rc", "[", "]"}], "]"}], "]"}], "->", 
   RowBox[{"%", "[", 
    RowBox[{"[", "1", "]"}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"beqspherc", "=", 
  RowBox[{
   RowBox[{"OverBar", "[", 
    RowBox[{"b", "[", 
     RowBox[{"rc", "[", "]"}], "]"}], "]"}], "->", 
   RowBox[{"%%", "[", 
    RowBox[{"[", "2", "]"}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"%%%", "[", 
     RowBox[{"[", "3", "]"}], "]"}], "/", 
    SuperscriptBox[
     RowBox[{"Sin", "[", 
      RowBox[{"\[Theta]c", "[", "]"}], "]"}], "2"]}], "-", 
   RowBox[{"%%%", "[", 
    RowBox[{"[", "2", "]"}], "]"}]}], "//", "Simplify", 
  RowBox[{"(*", 
   RowBox[{
   "check", " ", "that", " ", "the", " ", "2", "nd", " ", "and", " ", "3", 
