Cell["Construct the Lie derivative term:", "Text",
 CellChangeTimes->{{3.845995843936675*^9, 
  3.845995854449005*^9}},ExpressionUUID->"c341da6e-42cb-4bca-8028-\
13ed6d32d9b7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"liedterm", "=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"metricmat", "[", 
         RowBox[{"[", 
          RowBox[{"k", ",", "j"}], "]"}], "]"}], "*", 
        RowBox[{"dshiftmat", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "k"}], "]"}], "]"}]}], "+", 
       RowBox[{
        RowBox[{"metricmat", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "k"}], "]"}], "]"}], "*", 
        RowBox[{"dshiftmat", "[", 
         RowBox[{"[", 
          RowBox[{"j", ",", "k"}], "]"}], "]"}]}], "+", 
       RowBox[{
        RowBox[{"shiftvec", "[", 
         RowBox[{"[", "k", "]"}], "]"}], 
        RowBox[{"dmetricmat", "[", 
         RowBox[{"[", 
          RowBox[{"k", ",", "i", ",", "j"}], "]"}], "]"}]}]}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "1", ",", "3"}], "}"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", "3"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"j", ",", "1", ",", "3"}], "}"}]}], "]"}]}]], "Input",
