Cell["\<\
Set components for the extrinsic curvature with indices up by using the \
values stored for it with indices up and also the metric components \
(ToBasis[basis_name] sets the abstract indices to component indices in the \
basis basis_name (DummyToBasis[basis_name] does the same for indices that are \
being summed on), TraceBasisDummy expands suns on indices into their actual \
component numbers, ToValues sets the existing tensor component values):\
\>", "Text",
 CellChangeTimes->{{3.845996985302998*^9, 3.845997038338353*^9}, {
  3.845997404978457*^9, 3.845997426313376*^9}, {3.845998973008047*^9, 
  3.84599911154344*^9}},ExpressionUUID->"90923aee-b143-4999-abd4-\
ee0c1e1113cc"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"ComponentArray", "[", 
  RowBox[{"K", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"i", ",", "spher"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"j", ",", "spher"}], "}"}]}], "]"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ComponentArray", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"K", "[", 
        RowBox[{
         RowBox[{"-", "k"}], ",", 
         RowBox[{"-", "l"}]}], "]"}], 
       RowBox[{"metric", "[", 
        RowBox[{"i", ",", "k"}], "]"}], 
       RowBox[{"metric", "[", 
        RowBox[{"j", ",", "l"}], "]"}]}], "//", 
      RowBox[{"ToBasis", "[", "spher", "]"}]}], "//", "TraceBasisDummy"}], 
    "]"}], "//", "ToValues"}], "//", "Simplify"}], "\[IndentingNewLine]", 
 RowBox[{"ComponentValue", "[", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"%%", "[", 
      RowBox[{"[", 
       RowBox[{"ct1", ",", "ct2"}], "]"}], "]"}], "->", 
     RowBox[{"%", "[", 
      RowBox[{"[", 
       RowBox[{"ct1", ",", "ct2"}], "]"}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"ct1", ",", "1", ",", "3"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"ct2", ",", "1", ",", "3"}], "}"}]}], "]"}], "]"}]}], "Input",
 CellChangeTimes->{{3.845991573472253*^9, 3.84599166330684*^9}},
 CellLabel->"In[34]:=",ExpressionUUID->"f502ae87-dc88-405f-aaa9-6e2cd9bcc1ad"],

