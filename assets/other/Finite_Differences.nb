Cell["\<\
First order stencils (forward or backward difference operators): \
\>", "Text",ExpressionUUID->"3e51f37d-ef48-45e6-abfe-e301ea6e6550"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"m", "=", "1"}], ";", 
  RowBox[{"n", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"-", "h"}], ")"}], "^", "m"}], ")"}], " ", 
   RowBox[{"CoefficientList", "[", 
    RowBox[{
     RowBox[{"Normal", "[", 
      RowBox[{
       RowBox[{"Series", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"x", "^", "s"}], "*", 
          RowBox[{
           RowBox[{"Log", "[", "x", "]"}], "^", "m"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "1", ",", "n"}], "}"}]}], "]"}], "/", 
       RowBox[{"h", "^", "m"}]}], "]"}], ",", "x"}], "]"}]}], "//", 
  "Expand"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Table", "[", 
   RowBox[{"%", ",", 
    RowBox[{"{", 
     RowBox[{"s", ",", "0", ",", "n"}], "}"}]}], "]"}], "//", 
  "MatrixForm"}]}], "Input",
 CellLabel->"In[2]:=",ExpressionUUID->"8687888e-f6b8-4b37-bee8-472acba3389f"],

