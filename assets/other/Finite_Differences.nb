Cell["\<\
Check that they are order 1 (see power of h in the Taylor expansion at the \
end): \
\>", "Text",ExpressionUUID->"4577d43e-230e-4d33-b301-32c468b66d0a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"m", "=", "1"}], ";", 
  RowBox[{"n", "=", "1"}], ";", 
  RowBox[{"sval", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"-", "h"}], ")"}], "^", "m"}], ")"}], " ", 
    RowBox[{"CoefficientList", "[", 
     RowBox[{
      RowBox[{"Normal", "[", 
       RowBox[{
        RowBox[{"Series", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"x", "^", "s"}], "*", 
           RowBox[{
            RowBox[{"Log", "[", "x", "]"}], "^", "m"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "1", ",", "n"}], "}"}]}], "]"}], "/", 
        RowBox[{"h", "^", "m"}]}], "]"}], ",", "x"}], "]"}]}], "/.", 
   RowBox[{"s", "\[Rule]", "sval"}]}], "//", 
  "Expand"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Series", "[", 
       RowBox[{
        RowBox[{"f", "[", "#", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"h", ",", "0", ",", 
          RowBox[{"n", "+", "1"}]}], "}"}]}], "]"}], "&"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"h", 
        RowBox[{"(", "s", ")"}]}], ",", 
       RowBox[{"h", 
        RowBox[{"(", 
         RowBox[{"s", "-", "1"}], ")"}]}]}], "}"}]}], "]"}], "/.", 
   RowBox[{"s", "\[Rule]", "sval"}]}], "//", 
  "Normal"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"1", "/", 
    SuperscriptBox["h", "m"]}], " ", 
   RowBox[{"%%", ".", "%"}]}], "//", "Expand"}]}], "Input",
 CellLabel->
  "In[173]:=",ExpressionUUID->"dc40ab32-85df-475f-88b6-71d944a15059"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", 
   RowBox[{"-", "1"}]}], "}"}]], "Output",
 CellLabel->
  "Out[174]=",ExpressionUUID->"70e73de1-32a1-4b87-a46b-44a877b62acb"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"f", "[", "0", "]"}], ",", 
   RowBox[{
    RowBox[{"f", "[", "0", "]"}], "-", 
    RowBox[{"h", " ", 
     RowBox[{
      SuperscriptBox["f", "\[Prime]",
       MultilineFunction->None], "[", "0", "]"}]}], "+", 
    RowBox[{
     FractionBox["1", "2"], " ", 
     SuperscriptBox["h", "2"], " ", 
     RowBox[{
      SuperscriptBox["f", "\[Prime]\[Prime]",
       MultilineFunction->None], "[", "0", "]"}]}]}]}], "}"}]], "Output",
 CellLabel->
  "Out[175]=",ExpressionUUID->"d6057ebe-c642-42ef-88cd-4c8831a8262a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SuperscriptBox["f", "\[Prime]",
    MultilineFunction->None], "[", "0", "]"}], "-", 
