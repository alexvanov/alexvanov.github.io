Cell[CellGroupData[{

Cell["Creating stencils for finite difference operators", \
"Section",ExpressionUUID->"ef7d2868-8737-4882-90f5-2faac766ac28"],

Cell[CellGroupData[{

Cell["Basic explanation", \
"Subsection",ExpressionUUID->"f86832f5-8ac7-4a04-95c3-d69413e85763"],

Cell["\<\
n: number of spaces inside the stencil (one less than gridpoints)
m: order of the derivative
s: number of grid intervals between the leftmost function entry and the \
derivative; if derivative is centered, s = n/2 (it has to be an integer)\
\>", "Text",ExpressionUUID->"0734e45c-8e05-4e18-aaa9-e7ce34422b94"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "with", " ", "n", " ", "the", " ", "number", " ", "of", " ", "spaces", 
     " ", "inside", " ", "the", " ", "stencil", " ", 
     RowBox[{"(", 
      RowBox[{
      "so", " ", "one", " ", "less", " ", "than", " ", "gridpoints", " ", 
       "in", " ", "the", " ", "stencil"}], ")"}]}], ",", 
    RowBox[{
    "m", " ", "the", " ", "order", " ", "of", " ", "the", " ", "derivative", 
     " ", "and", " ", "s", " ", "the", " ", "number", " ", "of", " ", "grid", 
     " ", "intervals", " ", "between", " ", "the", " ", "leftmost", " ", 
     "function", " ", "entry", " ", "and", " ", "the", " ", "derivative"}]}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"-", "h"}], ")"}], 
      RowBox[{"(*", 
       RowBox[{
       "not", " ", "completely", " ", "sure", " ", "about", " ", "the", " ", 
        "former", " ", "parenthesis"}], "*)"}], "^", "m"}], ")"}], " ", 
    RowBox[{"CoefficientList", "[", 
     RowBox[{
      RowBox[{"Normal", "[", 
       RowBox[{
        RowBox[{"Series", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"x", "^", "s"}], "*", 
           RowBox[{
            RowBox[{"Log", "[", "x", "]"}], "^", "m"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "1", ",", "n"}], "}"}]}], "]"}], "/", 
        RowBox[{"h", "^", "m"}]}], "]"}], ",", "x"}], "]"}]}], "//", 
   "Expand"}]}]], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"b0024d59-ba9d-49be-910c-eee9402afb73"],

Cell[BoxData[
 TemplateBox[{
  "Series", "serlim", 
   "\"Series order specification \\!\\(\\*RowBox[{\\\"n\\\"}]\\) is not a \
machine-sized integer.\"", 2, 1, 1, 31376503098208181067, "Local"},
  "MessageTemplate"]], "Message", "MSG",
 CellLabel->
  "During evaluation of \
In[1]:=",ExpressionUUID->"e94b9ee3-fcd4-419b-8816-d30d5e42b484"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"-", "h"}], ")"}], "m"], " ", 
   SuperscriptBox["h", 
    RowBox[{"-", "m"}]], " ", 
   SuperscriptBox["x", "s"], " ", 
   SuperscriptBox[
    RowBox[{"Log", "[", "x", "]"}], "m"]}], "}"}]], "Output",
 CellLabel->"Out[1]=",ExpressionUUID->"d9fa7d1a-af13-4ab2-94cc-034bc1478714"]
}, Open  ]]
}, Open  ]],

